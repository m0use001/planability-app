<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v19.40：跨应用跳转需要**枚举全部已安装应用及其 activity**。
         Android 11+（本项目 minSdk 36）默认只能看见自己和 <queries> 里声明过的包，
         而 `<queries>` 是逐个包写死的——「跳转到某个应用的某个页面」是开放式的，
         每次多看一个应用就要改 manifest 再装包，等于不能用。
         Play 上架会被拒（那条政策只管 Play），本项目侧载自用，风险为零。
         注意它管的是**可见性**，管不了能不能启动：非 exported 的 activity 依然会 SecurityException，
         能不能跳由 ActivityInfo.exported 决定，见 core/AppJump.kt。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v14：地图选点要真定位（此前没声明也没实现，没历史点就落在北京） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v24：地理围栏触发需要后台定位。注意这是**延迟授权**的一档：

         只有用户真的建了一条带位置的自动化、我们要去申请时，系统才会弹出「始终允许」那一次。

         没有这类自动化时 GeoWatch 直接不注册监听，连这行权限都不会去碰。 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v43 补：BootReceiver 从 v14 起就声明了 BOOT_COMPLETED，但**这条权限一直缺失**，
         于是 Android 8+ 上开机广播实际收不到（v14 的"重启重挂闹钟"从未生效）。
         常驻自主循环依赖开机重建调度链，必须补上。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- v19.40：跨应用跳转需要枚举 LAUNCHER 应用（自动化 app_open / 跳转页用） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PlanabilityApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Planability">
        <!-- 屏幕方向：**不再在 manifest 锁竖屏**（平板适配 2026-11-16）。
             手机（smallestScreenWidthDp < 600）由 MainActivity.onCreate 运行时锁回竖屏，
             平板/折叠屏内屏则双向自由旋转——manifest 的 screenOrientation 是全设备生效的，
             没法按屏幕尺寸分叉，所以锁从声明挪到了代码里。
             configChanges 不含 uiMode：深色切换仍走 Activity 重建（主题/系统栏重算依赖它）。
             两个 launcher activity-alias 都指向本 Activity，方向由目标自己决定，alias 不用再写。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Planability"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

