            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 屏幕使用时间：谷歌同款（总时长 + 分 App 叠圆），放大显示更多 App 行，
             右上角刷新热区。数据在 data/ScreenTimeStats（与评分页屏幕时间同口径）。 -->
        <receiver
            android:name=".widget.ScreenTimeWidgetReceiver"
            android:label="@string/widget_screentime_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_screentime" />
        </receiver>

        <!-- 今日数据：谷歌电池组件同款「白条+彩色药丸」四行（待办/日程/专注/屏幕），
             药丸长度 = 该维度进度。见 widget/TodayStatsWidget.kt。 -->
        <receiver
            android:name=".widget.TodayStatsWidgetReceiver"
            android:label="@string/widget_todaystats_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todaystats" />
        </receiver>

        <!-- 大时钟（数字）：巨型胶囊，时间/日期/今日完成率。
             刷新没有独立策略，跟其它组件一起走 WidgetRefresh.all + 跨零点重推。 -->
        <receiver
            android:name=".widget.ClockWidgetReceiver"
            android:label="@string/widget_clock_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock" />
        </receiver>

        <!-- 大时钟（堆叠）：同款的竖版胶囊，小时/分钟分两行大字。 -->
        <receiver
            android:name=".widget.ClockStackedWidgetReceiver"
            android:label="@string/widget_clock_stacked_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_stacked" />
        </receiver>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.AutomationReceiver"
            android:exported="false" />

        <!-- v14：开机 / 应用更新后重挂闹钟。此前没有它，重启手机之后自动化巡检
             和日程提醒会全部失灵，直到用户手动打开一次 App。 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- v43：常驻自主循环的精确闹钟（30 分钟兜底；每次触发自续下一次）。
             与 WorkManager 15 分钟周期双通道，OEM 上互为主备。 -->
        <receiver
            android:name=".app.AutoTickReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.m0use001.planability.AUTO_TICK" />
            </intent-filter>
        </receiver>

        <!-- v19.42：事件触发的入口（开机/升级、充电插拔、解锁）。
     只声明**白名单内**的隐式广播：SCREEN_ON/SCREEN_OFF/HEADSET_PLUG 在 Android 8
     起不在白名单，manifest 里声明了也收不到，要收只能动态注册（那要求进程活着，
     就不再是「自动」了）。「打开应用时」走无障碍服务已有的窗口监听，不在这里。 -->
        <receiver
            android:name=".notify.AutomationSignalReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.ACTION_USER_PRESENT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- v14：手机端悬浮窗输入框。半透明 Activity 而非 WindowManager 悬浮窗，
             理由与手势/穿透策略见 ui/info/FloatChatActivity.kt 的类注释。 -->
        <!-- 竖屏锁定：与主 Activity 保持一致，避免分屏/转屏时输入框按横屏重排 -->
        <activity
            android:name=".ui.info.FloatChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Planability.Float"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- v43：应用内浏览器（浏览器自动化线的承载页）。
             AI 通过 browser_* 工具驱动它，用户可见、可打断；登录态由用户手动建立一次后复用 Cookie。
             singleTask：再次 browser_open 不重建窗口，直接换页（会话不丢）。
             2026-11-04：主题换成 translucent 变体——窗口做成底部圆角面板（占屏 86%、背后压暗），
             BrowserActivity 里再设 BOTTOM gravity；原来整屏硬切网页，用户不知道为什么跳转、也找不到回去的路。 -->
        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Planability.Browser"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- 后台悬浮服务：FloatChatActivity 退到后台时把浮窗搬进 TYPE_APPLICATION_OVERLAY 窗口，
             这样返回桌面/切别的 App 后聊天窗仍浮在最上层。见 FloatChatOverlayService 类注释。 -->
        <service
            android:name=".ui.info.FloatChatOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="让用户在使用其他应用时，聊天浮窗仍保持可见并可继续输入" />
        </service>
    </application>

</manifest>
