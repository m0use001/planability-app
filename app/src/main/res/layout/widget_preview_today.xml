<?xml version="1.0" encoding="utf-8"?>
<!--  静态预览布局（previewLayout），与位图运行时（WidgetArt）同一版式。
      ColorOS 类启动器不读本文件（只认 previewImage 位图），本文件给 AOSP/Pixel 用。
      只能用 RemoteViews 白名单控件；月历的表格细线只有位图/运行时有。-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_card_tight"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/googlesansflex"
            android:includeFontPadding="false"
            android:text="11/7 周六"
            android:textColor="@color/widget_preview_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/preview_fab"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_preview_on_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/preview_disc_rr" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="✓  取快递"
    android:textColor="@color/widget_preview_text"
    android:textSize="13sp"
    android:fontFamily="@font/googlesansflex" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/preview_chip_rr" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="项目组会"
    android:textColor="@color/widget_preview_text"
    android:textSize="13sp"
    android:fontFamily="@font/googlesansflex" />
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="14:30"
    android:textColor="@color/widget_preview_text_sub"
    android:textSize="10sp"
    android:fontFamily="@font/googlesansflex"
    android:layout_marginTop="1dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/preview_disc_rr" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="○  交微积分作业"
    android:textColor="@color/widget_preview_text"
    android:textSize="13sp"
    android:fontFamily="@font/googlesansflex" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/preview_chip_rr" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="线性代数"
    android:textColor="@color/widget_preview_text"
    android:textSize="13sp"
    android:fontFamily="@font/googlesansflex" />
    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="15:50"
    android:textColor="@color/widget_preview_text_sub"
    android:textSize="10sp"
    android:fontFamily="@font/googlesansflex"
    android:layout_marginTop="1dp" />
</LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_horizontal"
        android:text="待办 2/5 · 日程 3 场 · 专注 45 分"
        android:textColor="@color/widget_preview_text_sub"
        android:textSize="10sp" />
</LinearLayout>
