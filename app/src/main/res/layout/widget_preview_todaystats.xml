<?xml version="1.0" encoding="utf-8"?>
<!--
  「今日数据」的静态预览布局（previewLayout）：固定 4×2，**2×2 四个胶囊组**
  （2026-11-02 晚用户定案，与运行时位图渲染同版式）——每个胶囊 = 一块浮起来的组卡，
  内里左侧小环（静态满环，选择器缩略图画不了进度弧）、右侧名称/数值两行：
      ╭ ◯ 完成      ╮ ╭ ◯ 睡眠      ╮
      ╭ 3/5 项      ╯ ╭ 7h30m       ╯
  2026-11-03 用户「圆角矩形背景删掉」：整卡托盘不再画，四个胶囊直接浮在壁纸上；
  胶囊底 = 第二色家族彩面实色（preview_group_pill），环径同步放大到 26dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp">

    <!-- 上排：完成 / 睡眠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/preview_group_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/preview_ring_thick" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="待办"
                    android:textColor="@color/widget_preview_text_sub"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="2/5"
                    android:textColor="@color/widget_preview_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/preview_group_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/preview_ring_thick" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="睡眠"
                    android:textColor="@color/widget_preview_text_sub"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="6h58m"
                    android:textColor="@color/widget_preview_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 下排：专注 / 屏幕 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/preview_group_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/preview_ring_thick" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="专注"
                    android:textColor="@color/widget_preview_text_sub"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="45m"
                    android:textColor="@color/widget_preview_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/preview_group_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/preview_ring_thick" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="屏幕"
                    android:textColor="@color/widget_preview_text_sub"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesansflex"
                    android:text="3h20m"
                    android:textColor="@color/widget_preview_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
