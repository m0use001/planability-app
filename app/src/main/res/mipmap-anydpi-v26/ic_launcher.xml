<?xml version="1.0" encoding="utf-8"?>
<!--
  应用的**默认**图标（最近任务、Android 12+ 开屏、不认识 alias 的桌面）：
  固定用 palette 0（拼色「经典绿」）的日间套。
  桌面上的那个可见图标由 20 个 activity-alias 按「配色 × 明暗」切换，
  见 PlanabilityApp.kt 的 LauncherNightIcon——这里改不到那 20 份。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_day" />
    <foreground android:drawable="@drawable/ic_launcher_fg_pal0_day" />
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
