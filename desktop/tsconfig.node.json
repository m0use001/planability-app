{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"baseUrl": ".",
		"paths": { "@shared/*": ["shared/*"] }
	},
	"include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "shared/**/*"]
}
